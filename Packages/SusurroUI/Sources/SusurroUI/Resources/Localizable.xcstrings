    "providers.speechFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio stays on this Mac unless you turn on a cloud provider and choose it. Keys are read from your Keychain, service app.tuminuta, and never stored by Susurro."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El audio no sale de este Mac salvo que actives un proveedor en la nube y lo elijas. Las claves se leen de tu Llavero, servicio app.tuminuta, y Susurro nunca las guarda."
          }
        }
      }
    },
