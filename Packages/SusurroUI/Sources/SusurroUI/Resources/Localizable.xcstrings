    "fillers.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drops hesitations such as “eh”, “em” or “erm”, and keeps only the correction in “at 2, no, at 3”. It runs on this Mac, with or without cleanup, and leaves words that can mean something, such as “um” or “like”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quita titubeos como «eh», «em» o «erm», y deja solo la corrección en «a las 2, no, a las 3». Funciona en este Mac, con o sin limpieza, y no toca palabras que pueden significar algo, como «um» o «like»."
          }
        }
      }
    },
    "fillers.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
