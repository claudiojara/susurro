    "hotkey.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A shortcut with a regular key works without any permission. One made only of modifier keys, or the fn key, stays off until Input Monitoring is allowed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un atajo con una tecla normal funciona sin ningún permiso. Uno formado solo por teclas modificadoras, o la tecla fn, queda desactivado hasta que se permita Monitorización de entrada."
          }
        }
      }
    },
