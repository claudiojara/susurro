    },
    "audio.pauseMediaDetail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pauses music or video that is playing when you start, and resumes it when you finish. It sends the play/pause key, so it may reach a different app than the one you hear."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa la música o el video que suena al empezar y lo reanuda al terminar. Envía la tecla de reproducir/pausar, así que puede llegar a una app distinta de la que escuchas."
          }
        }
      }
    },
