            "state" : "translated",
            "value" : "The microphone Susurro records from. If the one you chose is not connected, the system default is used."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El micrófono con el que graba Susurro. Si el que elegiste no está conectado, se usa el predeterminado del sistema."
          }
