    "dictionary.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The speech model and the cleanup are asked to spell these terms as written. Nothing here is sent anywhere except to a cloud provider you turned on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se pide al modelo de voz y a la limpieza que escriban estos términos tal como están. Nada de esto se envía a ningún sitio, salvo a un proveedor en la nube que hayas activado."
          }
        }
      }
    },
