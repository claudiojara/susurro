    "providers.cleanupFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cloud cleanup provider receives the transcript, your dictionary words, the category, and the tone. It never receives the text around the cursor, the selection, or the screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un proveedor de limpieza en la nube recibe la transcripción, las palabras de tu diccionario, la categoría y el tono. Nunca recibe el texto alrededor del cursor, la selección ni la pantalla."
          }
        }
      }
    },
    "providers.speech" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
